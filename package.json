{
  "name": "lotto",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:init:local": "wrangler d1 execute lotto-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute lotto-db --remote --file=schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=lotto-webapp"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wrangler": "^4.160.0"
  }
}
