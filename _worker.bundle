  if (!db) {
    return new Response(JSON.stringify({ error: "DB binding missing" }), { status: 500 });
  }
  try {
    const draw = await context.request.json();
    await db.prepare(`
      INSERT INTO draw_results (lottery_id, lottery_name, draw_date, draw_time, full_number, digit_3_top, digit_2_top, digit_2_bottom, animal_name)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      draw.lotteryId,
      draw.lotteryName,
      draw.drawDate,
      draw.drawTime,
      draw.fullNumber,
      draw.digit3Top,
      draw.digit2Top,
      draw.digit2Bottom,
      draw.animalName
    ).run();
    const pendingTicketsQuery = await db.prepare("SELECT * FROM tickets WHERE status = 'pending'").all();
    const pendingTickets = pendingTicketsQuery.results || [];
    const itemsQuery = await db.prepare("SELECT * FROM ticket_items").all();
    const allItems = itemsQuery.results || [];
    let totalAwarded = 0;
    for (const ticket of pendingTickets) {
      const items = allItems.filter((it) => it.ticket_id === ticket.id);
      let ticketWon = false;
      let ticketWinAmount = 0;
      for (const item of items) {
        let isMatch = false;
        if (item.sub_type_id === "sub2Top" && item.number === draw.digit2Top) isMatch = true;
        if (item.sub_type_id === "sub2Bottom" && item.number === draw.digit2Bottom) isMatch = true;
        if (item.sub_type_id === "sub3Top" && item.number === draw.digit3Top) isMatch = true;
        if (isMatch) {
          ticketWon = true;
          ticketWinAmount += item.potential_win;
        }
      }
      if (ticketWon) {
        totalAwarded += ticketWinAmount;
        await db.prepare("UPDATE tickets SET status = 'won', win_amount = ? WHERE id = ?").bind(ticketWinAmount, ticket.id).run();
      } else {
        await db.prepare("UPDATE tickets SET status = 'lost', win_amount = 0 WHERE id = ?").bind(ticket.id).run();
      }
    }
    if (totalAwarded > 0) {
      await db.prepare("UPDATE users SET wallet_balance = wallet_balance + ? WHERE id = (SELECT id FROM users LIMIT 1)").bind(totalAwarded).run();
    }
    const updatedUser = await db.prepare("SELECT * FROM users LIMIT 1").first();
    return new Response(JSON.stringify({ success: true, totalAwarded, user: updatedUser }), {
      headers: { "Content-Type": "application/json" }
    });
  } catch (err) {
    return new Response(JSON.stringify({ error: err.message }), { status: 500 });
  }
}, "onRequestPost");

